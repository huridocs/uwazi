# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
ENVIRONMENT=

# ─── Database ─────────────────────────────────────────────────────────────────
# Use MONGO_URI for a full connection string, or DBHOST for just the host
MONGO_URI=
DBHOST=127.0.0.1
DBUSER=
DBPASS=
DATABASE_NAME=uwazi_development
MONGO_CONNECTION_POOL_SIZE=5

# ─── Elasticsearch ────────────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=
INDEX_NAME=uwazi_development

# ─── File paths ───────────────────────────────────────────────────────────────
ROOT_PATH=
FILES_ROOT_PATH=
UPLOADS_FOLDER=
CUSTOM_UPLOADS_FOLDER=
ACTIVITY_LOGS_FOLDER=

# ─── Multi-tenant ─────────────────────────────────────────────────────────────
MULTI_TENANT=false
DEFAULT_TENANT_DOMAIN=

# ─── Clustering / Redis ───────────────────────────────────────────────────────
CLUSTER_MODE=false
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── S3 storage ───────────────────────────────────────────────────────────────
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=uwazi-development
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BATCH_SIZE=1000

# ─── Queue ────────────────────────────────────────────────────────────────────
QUEUE_NAME=uwazi_jobs

# ─── Session ──────────────────────────────────────────────────────────────────
USER_SESSION_SECRET=

# ─── Sentry ───────────────────────────────────────────────────────────────────
SENTRY_API_DSN=

# ─── External services ────────────────────────────────────────────────────────
EXTERNAL_SERVICES=true
PARAGRAPH_EXTRACTION_URL=http://localhost:5056
# dummy_extractor_services: make start → 5051/5056
AI_ASSISTANT_SERVICE_URL=http://localhost:5051

# ─── Feature flags ────────────────────────────────────────────────────────────
FEATURE_FLAG_PARAGRAPH_EXTRACTION=false
FEATURE_FLAG_AI_ASSISTANT=true
FEATURE_FLAG_FILE_CACHE_HEADERS=false
FEATURE_FLAG_THEME_CUSTOMIZATION=false
FEATURE_FLAG_DATA_VIZ=false
NEW_HEADER=false

# Per-tenant override in MongoDB (multi-tenant / production):
# db.tenants.updateOne({ name: "..." }, { $set: { "featureFlags.dataViz": true } })
# db.tenants.updateOne({ name: "..." }, { $set: { "featureFlags.aiAssistant": true, "featureFlags.aiAssistantServiceUrl": "https://..." } })

# ─── Dev flags ────────────────────────────────────────────────────────────────
DEV_FLAG_TESTING=false

# ─── Misc ─────────────────────────────────────────────────────────────────────
JSON_LOGS=false
GITHUB_TOKEN=
