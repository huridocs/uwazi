{
  "workerIdleMemoryLimit": 0.2,
  "displayName": "Server",
  "testMatch": [
    "**/app/api/**/specs/*spec.(j|t)s?(x)",
    "**/app/shared/**/specs/*spec.(j|t)s?(x)",
    "**/app/specs/*spec.(j|t)s?(x)",
    "**/app/react/V2/services/server/**/specs/*spec.(j|t)s?(x)"
  ],
  "testEnvironment": "node",
  "setupFilesAfterEnv": [
    "<rootDir>/setUpJestServer.js",
    "<rootDir>/api/utils/jestCustomMatchers.ts"
  ],
  "snapshotFormat": {
    "escapeString": true,
    "printBasicPrototype": true
  },
  "fakeTimers": {
    "legacyFakeTimers": true
  },
  "moduleFileExtensions": ["ts", "tsx", "js", "jsx", "json", "node"],
  "transform": {
    "\\.[jt]sx?$": ["babel-jest", { "rootMode": "upward" }],
    "^.*/setUpJestServer\\.js$": ["babel-jest", { "rootMode": "upward" }]
  },
  "moduleNameMapper": {
    "^#api/(.*)\\.js$": "<rootDir>/api/$1",
    "^#api/(.*)": "<rootDir>/api/$1",
    "^#shared/(.*)\\.js$": "<rootDir>/shared/$1",
    "^#shared/(.*)": "<rootDir>/shared/$1",
    "^#app/(.*)\\.js$": "<rootDir>/react/$1",
    "^#app/(.*)": "<rootDir>/react/$1",
    "^#V2/(.*)\\.js$": "<rootDir>/react/V2/$1",
    "^#V2/(.*)": "<rootDir>/react/V2/$1",
    "^api/(.*)": "<rootDir>/api/$1",
    "^shared/(.*)": "<rootDir>/shared/$1",
    "^app/(.*)\\.js$": "<rootDir>/$1",
    "^app/(.*)": "<rootDir>/$1"
  }
}
