{
  "ts-node": {
    "require": ["tsconfig-paths/register"]
  },
  "compilerOptions": {
    "useUnknownInCatchVariables": false,
    "allowJs": true,
    "noEmit": false,
    "outDir": "./dist",
    "module": "ES2022",
    "target": "es2022",
    "jsx": "react",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true,
    "strict": true,
    "rootDir": ".",
    "types": ["*"],
    "noUncheckedSideEffectImports": false,
    "paths": {
      "#api/*": ["./app/api/*"],
      "#app/*": ["./app/react/*"],
      "#shared/*": ["./app/shared/*"],
      "#UI": ["./app/react/UI"],
      "#UI/*": ["./app/react/UI/*"],
      "#V2/*": ["./app/react/V2/*"],
      "#storybook/preview": ["./.storybook/preview.js"],
      "#api/utils/*": ["./app/api/utils/*"],
      "#app/utils/*": ["./app/react/utils/*"],
      // react-datepicker@9 ships an ESM build (dist/index.es.js) but its package.json
      // lacks "type": "module", so Node 22 loads it as CJS and throws
      // ERR_REQUIRE_CYCLE_MODULE. Force the CJS build for the tsx dev server.
      "react-datepicker": ["./node_modules/react-datepicker/dist/index.js"],
      "*": ["./*"]
    },
    //TODO: solve conflict between @types from react dependencies
    "skipLibCheck": true
  },
  "include": [
    "app",
    "external_modules",
    "database",
    "e2e",
    "playwright",
    "scripts/scripts.v2/*",
    "scripts/elasticSearch/*",
    ".storybook"
  ],
  "exclude": ["fixtures", "dist", "prod", "**/*.cy.tsx"]
}
