{
  "ts-node": {
    "require": ["tsconfig-paths/register"]
  },
  "compilerOptions": {
    "useUnknownInCatchVariables": false,
    "allowJs": true,
    "noEmit": false,
    "outDir": "./dist",
    "module": "ES2022",
    "target": "es2022",
    "jsx": "react",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true,
    "strict": true,
    "baseUrl": ".",
    "rootDir": ".",
    "paths": {
      "#api/*": ["./app/api/*"],
      "#app/*": ["./app/react/*"],
      "#shared/*": ["./app/shared/*"],
      "#UI": ["./app/react/UI"],
      "#UI/*": ["./app/react/UI/*"],
      "#V2/*": ["./app/react/V2/*"],
      "#api/utils/*": ["./app/api/utils/*"],
      "#app/utils/*": ["./app/react/utils/*"]
    },
    //TODO: solve conflict between @types from react dependencies
    "skipLibCheck": true
  },
  "include": ["app", "external_modules", "database", "e2e", "scripts/scripts.v2/*", "webpack.d.ts"],
  "exclude": ["fixtures", "dist", "prod", "**/*.cy.tsx"]
}
