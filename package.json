{
  "packageManager": "yarn@4.13.0",
  "name": "uwazi",
  "version": "1.228.296",
  "type": "module",
  "description": "Uwazi is a free, open-source solution for organising, analysing and publishing your documents.",
  "keywords": [
    "react"
  ],
  "homepage": "https://www.uwazi.io/",
  "bugs": {
    "url": "https://github.com/huridocs/uwazidocs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:huridocs/uwazidocs.git"
  },
  "license": "MIT",
  "author": "huridocs.org",
  "main": "server.js",
  "imports": {
    "#api": "./app/api/index.js",
    "#api/*": "./app/api/*",
    "#shared": "./app/shared/index.js",
    "#shared/*": "./app/shared/*",
    "#app": "./app/react/index.js",
    "#app/*": "./app/react/*",
    "#UI": "./app/react/UI/index.js",
    "#UI/*": "./app/react/UI/*",
    "#V2": "./app/react/V2/index.js",
    "#V2/*": "./app/react/V2/*"
  },
  "scripts": {
    "postinstall": "npx patch-package",
    "check-app-types": "tsc --noEmit --pretty",
    "check-cy-types": "tsc --noEmit --pretty --project cypress",
    "check-types": "yarn check-cy-types && yarn check-app-types",
    "watch-types": "tsc --noEmit --pretty --watch --preserveWatchOutput",
    "emit-types": "node --no-experimental-fetch scripts/emitSchemaTypes.cjs",
    "emitSocketEvent": "node ./scripts/runner.js ./scripts/emitSocketEvent.js",
    "production-build": "./webpack/build.sh",
    "build-production": "yarn production-build",
    "verify-build": "node --no-experimental-fetch ./scripts/verify-build.mjs",
    "run-production": "NODE_ENV=production node --no-experimental-fetch prod/server.js",
    "dev-server": "nodemon --inspect --no-experimental-fetch --loader ./css-loader.mjs --import tsx ./server.js --ignore 'app/dist/*' --watch 'app/api' --watch 'app/shared' --ext 'ts js tsx'",
    "webpack-server": "node --no-experimental-fetch ./webpack/webpack.server.js",
    "dev-worker": "tsx --no-experimental-fetch ./app/worker.ts",
    "dev-queue": "tsx --no-experimental-fetch --max-old-space-size=1024 --inspect=9230 ./app/queueWorker.ts",
    "new-files-healthcheck": "tsx ./scripts/scripts.v2/filesHealthCheck.ts",
    "denormalize-all-entities": "tsx ./scripts/scripts.v2/denormalizeAllEntities.ts",
    "generateAutomaticTranslationConfig": "tsx --no-experimental-fetch ./scripts/scripts.v2/generateAutomaticTranslationConfig.ts",
    "check-translations": "node --no-experimental-fetch ./scripts/checkTranslations.mjs",
    "update-translations-db": "node ./scripts/runner.js ./scripts/updateTranslationsDB.js",
    "update-translations-csv": "node --no-experimental-fetch ./scripts/updateTranslationsCSV.mjs",
    "describe-database": "node --no-experimental-fetch ./scripts/describeDatabase.mjs",
    "tailwind": "npx @tailwindcss/cli -i ./app/react/App/styles/tailwind.css -o ./app/react/App/styles/globals.css",
    "tailwind:watch": "npx @tailwindcss/cli -i ./app/react/App/styles/tailwind.css -o ./app/react/App/styles/globals.css --watch",
    "hot": "HOT=true BABEL_ENV=debug concurrently \"yarn run watch-types\" \"yarn run dev-server\" \"yarn run webpack-server\"",
    "hot-e2e": "DATABASE_NAME=uwazi_e2e INDEX_NAME=uwazi_e2e EXTERNAL_SERVICES=true SKIP_MIGRATION_CHECK=true yarn hot",
    "run-e2e": "NODE_ENV=production DATABASE_NAME=uwazi_e2e INDEX_NAME=uwazi_e2e ROOT_PATH=. EXTERNAL_SERVICES=true SKIP_MIGRATION_CHECK=true yarn run-production",
    "hot-inspect": "HOT=true BABEL_ENV=debug sh -c 'yarn run watch-types & yarn dev-server --inspect & yarn run webpack-server'",
    "hot-debug": "HOT=true BABEL_ENV=debug sh -c 'node --no-experimental-fetch --inspect=9229 server.js & yarn run webpack-server'",
    "reindex": "node ./scripts/runner.js ./database/reindex_elastic.js",
    "elastic-set-tenant-settings": "node ./scripts/runner.js ./database/elastic_set_tenant_settings.js",
    "import-csv": "node ./scripts/runner.js ./database/import_csv.js",
    "blank-state": "node --no-experimental-fetch scripts/bash.js ./database/blank_state.sh",
    "blank-state-shared-db": "node --no-experimental-fetch scripts/bash.js ./database/blank_state_shared_db.sh",
    "admin-user": "node --no-experimental-fetch scripts/bash.js ./database/admin_user.sh",
    "ix-config": "node --no-experimental-fetch scripts/bash.js ./database/ix_config.sh",
    "dump-db": "node --no-experimental-fetch scripts/bash.js ./database/dump_db.sh",
    "restore-db": "node --no-experimental-fetch scripts/bash.js ./database/restore_db.sh",
    "fixtures": "node --no-experimental-fetch scripts/bash.js ./uwazi-fixtures/restore.sh",
    "add-migration": "./node_modules/.bin/plop --plopfile ./app/api/migrations/plopfile.js migration",
    "migrate": "node ./scripts/runner.js ./scripts/migrate.js",
    "migrate-and-reindex": "node ./scripts/runner.js ./scripts/migrate_and_reindex.js",
    "test-debug": "node --no-experimental-fetch --inspect ./node_modules/.bin/jest --watch --no-cache -i",
    "test": "node --no-experimental-fetch ./node_modules/.bin/jest -w=50%",
    "e2e-puppeteer-all": "echo 'MAKE SURE UWAZI IS RUNNING WITH uwazi_e2e DATABASE AND INDEX';DATABASE_NAME=uwazi_e2e INDEX_NAME=uwazi_e2e jest --projects e2e/jest.e2e.config.ts -i --verbose true",
    "e2e-puppeteer": "yarn e2e-puppeteer-all --roots '<rootDir>/suite1' '<rootDir>/suite2'",
    "e2e-fixtures": "DATABASE_NAME=uwazi_e2e INDEX_NAME=uwazi_e2e ./uwazi-fixtures/restore.sh",
    "blank-e2e-fixtures": "DATABASE_NAME=uwazi_e2e INDEX_NAME=uwazi_e2e ./uwazi-fixtures/restore.blank-e2e.sh",
    "eslint": "./node_modules/.bin/eslint e2e app cypress --quiet",
    "eslint-fulldiff": "git diff-index --name-only origin/development | grep ^app/ | grep -v snap | xargs ls -d 2>/dev/null | xargs ./node_modules/.bin/eslint ",
    "prettier": "./node_modules/.bin/prettier --write 'app/**/*.{js,ts,tsx}'",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "cypress": "cypress open",
    "cy-components": "cypress run --component --config video=false --browser chrome",
    "cy-e2e": "cypress run --browser chrome",
    "playwright:test": "playwright test",
    "playwright:bootstrap": "playwright test playwright/e2e/bootstrap-state.spec.ts --workers=1",
    "playwright:auth-contract": "playwright test playwright/e2e/auth-gate.contract.spec.ts --workers=1",
    "playwright:ui": "playwright test --ui",
    "es:list": "tsx scripts/elasticSearch/ListIndexes.js",
    "es:migrate": "tsx scripts/elasticSearch/MigrateIndex.js",
    "es:dev:bootstrap": "tsx scripts/elasticSearch/RebuildESIndex.ts",
    "setup:dev": "yarn blank-state --force &&  yarn es:dev:bootstrap"
  },
  "jest": {
    "projects": [
      "app/jest.client.config.cjs",
      "app/jest.server.config.json"
    ]
  },
