{
  "name": "Uwazi Development",
  "dockerComposeFile": ["../docker-compose.yml", "docker-compose.yml"],
  "service": "app",
  "workspaceFolder": "/workspace",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Uwazi App",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "corepack enable && yarn install && sudo apt-get update && sudo apt-get install -y postgresql-client",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode", "mongodb.mongodb-vscode"],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers-contrib/features/mongodb-mongosh-mongo-tools:1": {}
  },
  "remoteUser": "node"
}
